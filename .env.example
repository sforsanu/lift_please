# Backend
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/lift
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=lift_session
SESSION_COOKIE_MAX_AGE_DAYS=7
BCRYPT_SALT_ROUNDS=12
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
SEARCH_RADIUS_DEFAULT_KM=10
SEED_DEMO_DATA=true

# Frontend
VITE_API_URL=http://localhost:3000
VITE_FRONTEND_HOST=0.0.0.0
VITE_FRONTEND_PORT=5173
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-api-key
